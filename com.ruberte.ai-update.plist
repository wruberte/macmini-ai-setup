<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
 "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.ruberte.ai-update</string>

    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>__HOME__/ai-stack/update-ai-stack.sh</string>
    </array>

    <!-- Run once at login/boot -->
    <key>RunAtLoad</key>
    <true/>

    <!-- Do NOT keep restarting it — it's a one-shot update job -->
    <key>KeepAlive</key>
    <false/>

    <key>StandardOutPath</key>
    <string>__HOME__/ai-stack/logs/launchd-update.out.log</string>
    <key>StandardErrorPath</key>
    <string>__HOME__/ai-stack/logs/launchd-update.err.log</string>
</dict>
</plist>
